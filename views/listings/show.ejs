<% layout("/layouts/boilerplate") %>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
    const pricePerNight = <%= listing.price %>;
</script>

<div class="row mt-4 mb-3">
    <div class="col-8 offset-2">
        <h3 class="fw-bold"><%= listing.title %></h3>
    </div>
  
    <div class="col-8 offset-2">
        <img src="<%= listing.image.url %>" class="show-img rounded-3 w-100 mb-4" alt="listing image"/>
    </div>
  
    <div class="col-5 offset-2">
        <div class="d-flex align-items-center gap-3 pb-3 border-bottom mb-3">
            <div class="owner-avatar"><%= listing.owner.username.slice(0,2).toUpperCase() %></div>
            <div>
                <div class="fw-semibold">Hosted by <%= listing.owner.username %></div>
                <div class="text-muted" style="font-size:13px;">Owner</div>
            </div>
        </div>
        <p class="text-muted"><%= listing.description %></p>
        <p class="text-muted"><i class="fa-solid fa-location-dot"></i> <%= listing.location %></p>
        <p class="text-muted"><i class="fa-solid fa-globe"></i> <%= listing.country %></p>

        <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
        <div class="d-flex gap-5 mt-3">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirmDelete()">
                <button class="btn btn-dark delete-btn">Delete</button>
            </form>
        </div>
        <% } %>
    </div>

    <%# Booking card %>
    <div class="col-3">
        <div class="booking-card">
            <div class="d-flex align-items-baseline gap-1 mb-3">
                <span class="fs-4 fw-bold">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                <span class="text-muted" style="font-size:13px;">/ night</span>
            </div>

            <div class="date-grid mb-2">
                <div class="date-cell">
                    <div class="date-label">CHECK-IN</div>
                    <input type="date" id="check-in" class="date-input"/>
                </div>
                <div class="date-cell border-start">
                    <div class="date-label">CHECK-OUT</div>
                    <input type="date" id="check-out" class="date-input"/>
                </div>
            </div>

            <div class="guests-row mb-3">
                <div>
                    <div class="date-label">GUESTS</div>
                    <div id="guest-label" style="font-size:13px;">1 guest</div>
                </div>
                <div class="guests-ctrl">
                    <button type="button" onclick="changeGuests(-1)" class="guest-btn">-</button>
                    <span id="guest-count" class="mx-2">1</span>
                    <button type="button" onclick="changeGuests(1)" class="guest-btn">+</button>
                </div>
            </div>

            <% if(currUser && !listing.owner._id.equals(currUser._id)) { %>
                <a href="/bookings/<%= listing._id %>" class="btn book-btn w-100 text-white">Reserve</a>
                <p class="text-center text-muted mt-2" style="font-size:12px;">You won't be charged yet</p>
            <% } else if(currUser) { %>
                <p class="text-center text-muted mt-2" style="font-size:13px;">You can't book your own listing</p>
            <% } else { %>
                <a href="/login" class="btn book-btn w-100 text-white">Login to Reserve</a>
            <% } %>

        </div>
    </div>

    <div class="col-8 offset-2 mt-4">
        <hr>
        <% if(currUser) { %>
        <h4 class="fw-semibold">Leave a Review</h4>
        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label fw-semibold">Comment</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control" required></textarea>
                <div class="invalid-feedback">Please add some comments for review</div>
            </div>
            <button class="btn btn-dark">Submit</button>
        </form>
        <% } %>

        <% if(listing.reviews.length > 0) { %>
        <div class="row mt-4">
            <h5 class="mb-3 fw-bold">All Reviews</h5>
            <% for(let review of listing.reviews) { %>
                <div class="card review-card col-md-5 col-12 ms-md-3 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@<%= review.author.username %></h5>
                        <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                        <p class="card-text"><%= review.comment %></p>
                        <% if(currUser && review.author._id.equals(currUser._id)) { %>
                            <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" onsubmit="return confirmDelete()">
                                <button class="btn btn-sm btn-dark">Delete</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
        <% } %>
    </div>

    <%# Map %>
    <div class="col-8 offset-2 mt-3 mb-3">
        <hr>
        <h4 class="fw-semibold">Where you'll be</h4>
        <p><%= listing.location %>, <%= listing.country %></p>
        <div id="map"></div>
    </div>
</div>

<script src="/js/script.js"></script>

<script src="/js/map.js"></script>