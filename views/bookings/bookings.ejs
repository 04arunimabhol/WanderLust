<% layout("/layouts/boilerplate") %>
<script>
    const pricePerNight = <%= listing.price %>;
</script>

<div class="row mt-3 mb-5">
  <div class="d-flex align-items-center justify-content-center gap-3 mb-3">
    <a href="/listings/<%= listing._id %>" class="text-dark text-decoration-none">
       <i class="fa-solid fa-arrow-left-long fs-4"></i>
    </a>
    <h2 class="fw-bold">Request to Book</h2>
  </div>

  <div class="booking-wrapper">
    <div class="booking-card">
      <div class="text-center">
        <img
          src="<%= listing.image.url %>"
          alt="listing-image"
          class="img-fluid rounded"
          style="height: 200px; width: 100%; object-fit: cover"
        />
        <h3 class="mt-3 fw-bold"><%= listing.title %></h3>
        <p class="text-muted">&#8377; <%= listing.price.toLocaleString("en-IN") %> / night</p>
      </div>

      <form action="/bookings/<%= listing._id %>" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="check-in" class="form-label">Check In</label>
          <input type="date" id="check-in" name="checkIn" class="form-control" required />
          <div class="invalid-feedback">Please add a valid check-in date</div>
        </div>

        <div class="mb-3">
          <label for="check-out" class="form-label">Check Out</label>
          <input type="date" id="check-out" name="checkOut" class="form-control" required />
          <div class="invalid-feedback">Please add a valid check-out date</div>
        </div>

        <input type="hidden" id="guests-input" name="guests" value="1" />
        <div class="mb-3">
          <label class="form-label">Guests</label>
          <div class="guests-row">
            <div>
              <div id="guest-label" style="font-size:15px;">1 guest</div>
            </div>
            <div class="guests-ctrl">
              <button type="button" onclick="changeGuests(-1)" class="guest-btn">−</button>
              <span id="guest-count" class="mx-2">1</span>
              <button type="button" onclick="changeGuests(1)" class="guest-btn">+</button>
            </div>
          </div>
        </div>
        <div class="mb-3">
          <h5 class="mt-4">Price Details</h5>
          <div class="d-flex justify-content-between text-muted">
            <span>&#8377;<%= listing.price.toLocaleString("en-IN") %> × <span id="nights">0</span> nights × <span id="guests-display">1</span> guest</span>
            <span id="total-price">&#8377;0</span>
          </div>
          <div class="d-flex justify-content-between text-muted mt-1">
            <span>Taxes (5%)</span>
            <span>&#8377;<span id="taxes">0</span></span>
          </div>
          <hr>
          <div class="d-flex justify-content-between fw-bold fs-5">
            <span>Total</span>
            <span id="grand-total">&#8377;0</span>
          </div>
        </div>

        <button class="btn btn-dark confirm-btn w-100">Confirm Booking</button>
      </form>
    </div>
  </div>
</div>

<script src="/js/script.js"></script>